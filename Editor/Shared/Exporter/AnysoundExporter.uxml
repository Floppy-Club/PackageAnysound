<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Anysound/Shared/uss/AnysoundStyles.uss?fileID=7433441132597879392&amp;guid=1e040dc50fcfa49f0aa3378443d2ffaa&amp;type=3#AnysoundStyles" />
    <Style src="project://database/Assets/Anysound/Shared/Generators/Footsteps/Frontend/uss/SliderElement.uss?fileID=7433441132597879392&amp;guid=aca955fb57f574bc5bc464c79efeee4c&amp;type=3#SliderElement" />
    <engine:VisualElement style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 100%; max-height: 100%; min-height: 100%; padding-top: 14px; padding-bottom: 14px; padding-right: 14px; padding-left: 14px;">
        <engine:VisualElement style="flex-grow: 0; background-color: rgb(0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; height: 60px; max-height: 60px; min-height: 60px;">
            <engine:VisualElement name="HeaderContainer" class="header-element">
                <engine:Label text="EXPORT" name="HeaderLabel" class="header-label" />
            </engine:VisualElement>
        </engine:VisualElement>
        <AnysoundSlider low-value="1" label="Number of audio clips" high-value="20" show-input-field="false" color="#FFBB22FF" name="NumberOfClips" unit="clips" enabled="true" inverted="false" isEnabled="true" integer-only="true" show-values="true" style="flex-grow: 0; height: 80%; max-height: 80px; margin-bottom: 20px;" />
        <engine:Button text="Create" name="ExportButton" class="anysound-button-box" style="height: 80px;" />
    </engine:VisualElement>
</engine:UXML>
