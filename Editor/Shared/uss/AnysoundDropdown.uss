.anysound-dropdown {
    margin: 8px 0 0 0;
    -unity-font-definition: url("project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&guid=e1005e063d97148efacf3cc3692560e8&type=3#IBMPlexMono-Medium");
}

.anysound-dropdown__input {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 4px 8px 4px 4px;
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-radius: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.anysound-dropdown__input--hover {
    background-color: rgb(20, 20, 20);
}

.anysound-dropdown__input-icon {
    width: 56px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}

.anysound-dropdown__input-label {
    flex-grow: 1;
    font-size: 12px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.anysound-dropdown__chevron {
    font-size: 14px;
    margin: 0;
    padding: 0;
    transition-property: rotate;
    transition-duration: 0.15s;
}

.anysound-dropdown__popup {
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-radius: 0;
    padding: 6px;
    -unity-font-definition: url("project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&guid=e1005e063d97148efacf3cc3692560e8&type=3#IBMPlexMono-Medium");
}

.anysound-dropdown__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.anysound-dropdown__tile {
    width: 84px;
    padding: 6px 6px 4px 6px;
    margin: 2px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.anysound-dropdown__tile--highlighted {
    background-color: rgb(20, 20, 20);
}

.anysound-dropdown__tile-icon {
    width: 70px;
    height: 40px;
}

.anysound-dropdown__tile-label {
    font-size: 10px;
    margin: 4px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}
