.anysound-button {
    margin: 0;
    padding: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-image-tint-color: white;
}

.anysound-button-box {
    background-color: transparent;
    border-left-color: rgb(94, 94, 94);
    border-right-color: rgb(94, 94, 94);
    border-top-color: rgb(94, 94, 94);
    border-bottom-color: rgb(94, 94, 94);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.anysound-button-box:hover {
    background-color: rgb(96, 199, 92);
    -unity-background-image-tint-color: black;
}

.anysound-button-box:active {
    background-color: rgb(244, 64, 78);
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.anysound-button-box:disabled {
    border-left-color: rgb(87, 87, 87);
    border-right-color: rgb(87, 87, 87);
    border-top-color: rgb(87, 87, 87);
    border-bottom-color: rgb(87, 87, 87);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.13);
}

.section-label {
    flex-grow: 1;
    justify-content: center;
    padding: 2px;
    margin: 0;
}

.size-label {
    height: 10px;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.section-label {
    flex-grow: 1;
    justify-content: center;
    padding: 2px;
    margin: 0;
}

.size_icon {
    flex-grow: 0;
    background-size: 100% 100%;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
}

.surface-icon {
    background-image: url("project://database/Assets/Anysound/Shared/Generators/Footsteps/svg/Resources/surface_dirt.svg?fileID=7388822144124034973&guid=4e12fb0d09f3d4d8bb1908a542e83785&type=3#surface_dirt");
    width: 100%;
    height: 40px;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 0;
    margin-left: 0;
}

.browse-button {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&guid=a6603d1db13644a958c1ff883c8109e2&type=3#IBMPlexMono-Regular");
    background-color: rgb(96, 199, 92);
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    height: 36px;
}

.header-label {
    -unity-font-definition: url("project://database/Assets/Fonts/IBMPlexMono-Light.ttf?fileID=12800000&guid=c66c55044e1e5491b90d92aa9f9bcb47&type=3#IBMPlexMono-Light");
    color: rgb(255, 255, 255);
    font-size: 28px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: upper-left;
}

.header-element {
    flex-grow: 0;
    align-content: flex-end;
    justify-content: flex-start;
    align-self: auto;
    height: 60px;
    max-height: 60px;
    min-height: 60px;
    align-items: flex-start;
}
