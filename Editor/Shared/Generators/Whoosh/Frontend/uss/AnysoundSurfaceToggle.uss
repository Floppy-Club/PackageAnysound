.custom-toggle-control {
    transition: all 0.2s ease;
    flex-grow: 1;
    margin-right: 5px;
}

.custom-toggle-control.toggled {

}

.icon-container {
    transition: all 0.2s ease;
    background-position-y: bottom 0;
    background-position-x: center;
    -unity-background-scale-mode: stretch-to-fill;
    width: 100%;
    height: 40px;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 0;
    margin-left: 0;
}

.icon-container.toggled {
}

.toggle-name-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
    color: #7E5907;
    transition: all 0.2s ease;
    font-size: 10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&amp;guid=a6603d1db13644a958c1ff883c8109e2&amp;type=3#IBMPlexMono-Regular");

}

.toggle-name-label.toggled {
    color: #FFBB22;
}

