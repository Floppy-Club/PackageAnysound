.anysound-button {
    margin: 0;
    padding: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-image-tint-color: white;
}

.anysound-button-box {
    background-color: transparent;
}

.anysound-button-box:hover {
    background-color: rgb(96, 199, 92);
    -unity-background-image-tint-color: black;
}

.anysound-button-box:active {
    background-color: rgb(244, 64, 78);
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.section-label {
    flex-grow: 1;
    justify-content: center;
    padding: 2px;
    margin: 0;
}

.size-label {
    height: 10px;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.section-label {
    flex-grow: 1;
    justify-content: center;
    padding: 2px;
    margin: 0;
}

.size_icon {
    flex-grow: 0;
    background-size: 100% 100%;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
}

.surface-icon {
    background-image: url("project://database/Assets/Anysound/Editor/svg/Resources/surface_concrete.svg?fileID=7388822144124034973&guid=4e12fb0d09f3d4d8bb1908a542e83785&type=3#surface_concrete");
    width: 100%;
    height: 40px;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 0;
    margin-left: 0;
}
