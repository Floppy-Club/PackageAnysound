.custom-toggle-control {
    transition: all 0.2s ease;
    flex-grow: 1;
    margin-right: 5px;
}

.custom-toggle-control.toggled {
}

.icon-container {
    transition: all 0.2s ease;
    background-position-y: bottom 0;
    background-position-x: center;
    -unity-background-scale-mode: stretch-to-fill;
    width: 100%;
    height: 40px;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 0;
    margin-left: 0;
}

.icon-container.toggled {
}

.toggle-name-label {
    transition: all 0.2s ease;
    font-size: 10px;
    color: rgb(156, 117, 27);
}

.toggle-name-label.toggled {
    color: rgb(255, 187, 34);
}
