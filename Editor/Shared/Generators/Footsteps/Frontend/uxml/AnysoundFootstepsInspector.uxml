<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/Generators/Footsteps/Frontend/uss/SliderElement.uss?fileID=7433441132597879392&amp;guid=aca955fb57f574bc5bc464c79efeee4c&amp;type=3#SliderElement"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/Generators/Footsteps/Frontend/uss/AnysoundSurfaceToggle.uss?fileID=7433441132597879392&amp;guid=77f1e976f4e394b148f02e71fe20b1fb&amp;type=3#AnysoundSurfaceToggle"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/uss/AnysoundStyles.uss?fileID=7433441132597879392&amp;guid=1e040dc50fcfa49f0aa3378443d2ffaa&amp;type=3#AnysoundStyles"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/uss/AnysoundDropdown.uss?fileID=7433441132597879392&amp;guid=7b8ede17e160441992f477aedaafaed2&amp;type=3#AnysoundDropdown"/>
    <engine:ScrollView style="margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; min-width: 400px;">
        <engine:VisualElement style="flex-grow: 0; height: 637px; background-color: rgb(0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 14px; padding-right: 14px; padding-bottom: 14px; padding-left: 14px;">
            <engine:VisualElement name="Header" class="header-element" style="flex-grow: 0; background-color: rgb(0, 0, 0); align-self: stretch; justify-content: space-between; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: row;">
                <engine:Label text="FOOTSTEPS" class="header-label"/>
                <engine:Button text="BROWSE" name="BackButton" class="browse-button" style="flex-grow: 1; max-width: 64px;"/>
            </engine:VisualElement>
            <engine:VisualElement name="Preview" style="flex-grow: 0; height: 324px; background-color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&amp;guid=a6603d1db13644a958c1ff883c8109e2&amp;type=3#IBMPlexMono-Regular&quot;);">
                <engine:VisualElement name="MovementElement" style="flex-grow: 0; height: 100px; flex-direction: row; flex-shrink: 0;">
                    <engine:VisualElement name="VisualElement" style="flex-grow: 0; width: 64px;">
                        <engine:VisualElement style="flex-grow: 0; height: 16px; background-color: rgb(96, 199, 92);">
                            <engine:Label text="MOVEMENT" class="section-label" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 10px;"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(96, 199, 92);"/>
                        <engine:VisualElement class="generator-hint-row">
                            <engine:Label text="SNEAK" class="generator-hint-label" style="color: rgb(96, 199, 92);"/>
                            <engine:Label text="RUN" class="generator-hint-label" style="color: rgb(96, 199, 92);"/>
                        </engine:VisualElement>
                        <AnysoundSlider label="Movement" name="MovementTypeSlider" show-input-field="false" high-value="2" low-value="0" color="#60C75CFF" inverted="false" value="1" show-label="false" show-values="false" style="flex-shrink: 0; align-self: auto; align-content: auto; visibility: visible; opacity: 1; height: 60px; flex-grow: 0;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="SizeElement" style="flex-grow: 0; height: 190px; flex-direction: row; flex-shrink: 0;">
                    <engine:VisualElement name="VisualElement" style="flex-grow: 0; width: 64px;">
                        <engine:VisualElement style="flex-grow: 0; height: 16px; background-color: rgb(60, 166, 255);">
                            <engine:Label text="SIZE" class="section-label" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 10px;"/>
                        </engine:VisualElement>
                        <engine:VisualElement name="SizeLabelsContainer" style="flex-grow: 1; margin-top: 10px; margin-bottom: 10px;">
                            <engine:Label text="XXL" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                            <engine:Label text="XL" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                            <engine:Label text="L" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                            <engine:Label text="M" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                            <engine:Label text="S" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                            <engine:Label text="XS" class="size-label" style="color: rgb(60, 166, 255); font-size: 10px; -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-SemiBold.ttf?fileID=12800000&amp;guid=7ff7d8e76556a449a856aad3ca8ea896&amp;type=3#IBMPlexMono-SemiBold&quot;);"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement style="flex-grow: 1;">
                        <engine:VisualElement name="VisualElement" style="flex-grow: 0; background-color: rgb(60, 166, 255); height: 2px;"/>
                        <engine:VisualElement name="SizeIconsContainer" style="flex-grow: 0; background-image: none; -unity-background-scale-mode: stretch-to-fill; background-color: rgba(147, 84, 84, 0); flex-shrink: 1; background-size: 64px 64px; -unity-slice-scale: 0; flex-direction: row; align-items: flex-end; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; margin-bottom: 10px; justify-content: space-around; margin-right: -9px; margin-left: -13px; height: 100px;">
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: resource(&quot;size_xs_run&quot;); margin-right: -23px; margin-left: -22px;"/>
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: resource(&quot;size_xl_run_fill&quot;); margin-left: -21px; margin-right: -21px;"/>
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: none; margin-left: -17px; margin-right: -19px;"/>
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: none; margin-left: -13px; margin-right: -13px;"/>
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: none; margin-left: -10px; margin-right: -10px;"/>
                            <engine:VisualElement name="SizeIcon" class="size_icon" style="flex-direction: row; background-color: rgba(183, 66, 66, 0); background-image: none; margin-left: -7px; margin-right: -6px;"/>
                        </engine:VisualElement>
                        <AnysoundSlider label="Size" name="SizeSlider" show-input-field="false" high-value="2" low-value="0" color="#3CA6FFFF" unit="%" inverted="false" value="1" show-values="false" fill="false" show-label="false" style="flex-shrink: 0; align-self: auto; align-content: auto; visibility: visible; opacity: 1; height: 60px; flex-grow: 0;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="SurfaceElement" style="flex-grow: 0; height: 150px; flex-direction: row; flex-shrink: 0;">
                    <engine:VisualElement name="VisualElement" style="flex-grow: 0; width: 64px;">
                        <engine:VisualElement style="flex-grow: 0; height: 16px; background-color: rgb(255, 187, 34);">
                            <engine:Label text="SURFACE" class="section-label" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 10px;"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement style="flex-grow: 1;">
                        <engine:VisualElement name="VisualElement" style="flex-grow: 0; background-color: rgb(255, 187, 34); height: 2px;"/>
                        <engine:VisualElement class="generator-clip-row" style="margin-top: 14px;">
                            <AnysoundDropdown name="SurfaceADropdown" color="#FFBB22FF" class="generator-clip-row__type"/>
                            <AnysoundDropdown name="SurfaceBDropdown" color="#FFBB22FF" class="generator-clip-row__type" style="margin-right: 0;"/>
                        </engine:VisualElement>
                        <engine:VisualElement class="generator-hint-row">
                            <engine:Label name="SurfaceALabel" text="A" class="generator-hint-label" style="color: rgb(255, 187, 34);"/>
                            <engine:Label name="SurfaceBLabel" text="B" class="generator-hint-label" style="color: rgb(255, 187, 34);"/>
                        </engine:VisualElement>
                        <AnysoundSlider label="Surface" name="SurfaceSlider" show-input-field="false" high-value="1" low-value="0" color="#FFBB22FF" inverted="false" value="0" show-label="false" show-values="false" style="flex-shrink: 0; align-self: auto; align-content: auto; visibility: visible; opacity: 1; height: 60px; flex-grow: 0;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="AudioElement" style="flex-grow: 0; height: 80px; flex-direction: row; flex-shrink: 0;">
                    <engine:VisualElement style="flex-grow: 0; width: 64px;">
                        <engine:VisualElement style="flex-grow: 0; height: 16px; background-color: rgb(244, 64, 78);">
                            <engine:Label text="AUDIO" class="section-label" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 10px; justify-content: center;"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement style="flex-grow: 1;">
                        <engine:VisualElement style="flex-grow: 0; background-color: rgb(244, 64, 78); height: 2px;"/>
                        <engine:VisualElement name="Playhead" style="flex-grow: 1; height: 10px; position: relative; width: 2px; display: flex; background-color: rgb(244, 64, 78); max-height: 14px; opacity: 1; left: 5%; visibility: hidden;"/>
                        <engine:VisualElement name="WaveformContainer" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);"/>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="Sliders" style="flex-grow: 0; flex-shrink: 0;"/>
        <engine:VisualElement name="Buttons" style="flex-grow: 0; flex-direction: row; height: 142px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 10px;">
            <engine:VisualElement name="AnytwhenButton" class="anysound-button" style="flex-grow: 1;">
                <engine:Label text="Export to project" style="-unity-text-align: middle-left; height: 30px; width: 150px;"/>
                <engine:Button display-tooltip-when-elided="false" name="ExportButton" class="anysound-button-box" style="background-image: resource(&quot;button_export&quot;); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 100px; -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142); margin-right: 20px;"/>
            </engine:VisualElement>
            <engine:VisualElement name="AnytwhenButton" class="anysound-button" style="flex-grow: 1;">
                <engine:Label text="Preview sound (spacebar)" style="-unity-text-align: middle-left; height: 30px; width: 150px;"/>
                <engine:Button display-tooltip-when-elided="false" name="PreviewButton" class="anysound-button-box" style="border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 100px; -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142); background-image: resource(&quot;button_preview&quot;);"/>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button text="Create preset" name="RedrawButton" style="display: none;"/>
    </engine:ScrollView>
    <engine:VisualElement name="VisualElement" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-shrink: 0;"/>
</engine:UXML>
