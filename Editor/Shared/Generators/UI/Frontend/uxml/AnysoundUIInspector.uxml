<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/Generators/Footsteps/Frontend/uss/SliderElement.uss?fileID=7433441132597879392&amp;guid=aca955fb57f574bc5bc464c79efeee4c&amp;type=3#SliderElement"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/Generators/Footsteps/Frontend/uss/AnysoundSurfaceToggle.uss?fileID=7433441132597879392&amp;guid=77f1e976f4e394b148f02e71fe20b1fb&amp;type=3#AnysoundSurfaceToggle"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/uss/AnysoundStyles.uss?fileID=7433441132597879392&amp;guid=1e040dc50fcfa49f0aa3378443d2ffaa&amp;type=3#AnysoundStyles"/>
    <Style src="project://database/Packages/com.floppyclub.anysound/Editor/Shared/uss/AnysoundDropdown.uss?fileID=7433441132597879392&amp;guid=7b8ede17e160441992f477aedaafaed2&amp;type=3#AnysoundDropdown"/>
    <engine:ScrollView style="margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; min-width: 400px;">
        <engine:VisualElement style="flex-grow: 0; flex-shrink: 0; background-color: rgb(0, 0, 0); padding-top: 14px; padding-right: 14px; padding-bottom: 14px; padding-left: 14px;">
            <engine:VisualElement name="Header" class="header-element" style="flex-grow: 0; background-color: rgb(0, 0, 0); align-self: stretch; justify-content: space-between; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: row;">
                <engine:Label text="UI" class="header-label"/>
                <engine:Button text="BROWSE" name="BackButton" class="browse-button" style="flex-grow: 1; max-width: 64px;"/>
            </engine:VisualElement>
            <engine:VisualElement name="Preview" style="flex-grow: 0; background-color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&amp;guid=a6603d1db13644a958c1ff883c8109e2&amp;type=3#IBMPlexMono-Regular&quot;);">
                <engine:VisualElement name="ActionElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(255, 187, 34);">
                            <engine:Label text="ACTION" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(255, 187, 34);"/>
                        <engine:VisualElement class="generator-clip-row">
                            <AnysoundDropdown name="ActionDropdown" color="#FFBB22FF" class="generator-clip-row__type"/>
                            <engine:Button name="ActionRandomButton" tooltip="New random step values within the action's ranges" class="generator-random-button" style="color: #FFBB22; border-left-color: #FFBB22; border-right-color: #FFBB22; border-top-color: #FFBB22; border-bottom-color: #FFBB22;">
                                <AnysoundDiceIcon class="generator-random-button__icon"/>
                            </engine:Button>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="MaterialElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(96, 199, 92);">
                            <engine:Label text="MATERIAL" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(96, 199, 92);"/>
                        <engine:VisualElement class="generator-clip-row">
                            <AnysoundDropdown name="MaterialDropdown" color="#60C75CFF" class="generator-clip-row__type"/>
                            <AnysoundDropdown name="MaterialClipDropdown" color="#60C75CFF" show-icons="false" class="generator-clip-row__clip"/>
                            <engine:Button name="MaterialRandomButton" tooltip="Randomize this row" class="generator-random-button" style="color: #60C75C; border-left-color: #60C75C; border-right-color: #60C75C; border-top-color: #60C75C; border-bottom-color: #60C75C;">
                                <AnysoundDiceIcon class="generator-random-button__icon"/>
                            </engine:Button>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="ExtraMaterialElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(168, 130, 255);">
                            <engine:Label text="MATERIAL 2" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(168, 130, 255);"/>
                        <engine:VisualElement class="generator-clip-row">
                            <AnysoundDropdown name="ExtraMaterialDropdown" color="#A882FFFF" class="generator-clip-row__type"/>
                            <AnysoundDropdown name="ExtraMaterialClipDropdown" color="#A882FFFF" show-icons="false" class="generator-clip-row__clip"/>
                            <engine:Button name="ExtraMaterialRandomButton" tooltip="Randomize this row" class="generator-random-button" style="color: #A882FF; border-left-color: #A882FF; border-right-color: #A882FF; border-top-color: #A882FF; border-bottom-color: #A882FF;">
                                <AnysoundDiceIcon class="generator-random-button__icon"/>
                            </engine:Button>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="ExtraElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(255, 128, 191);">
                            <engine:Label text="EXTRA" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(255, 128, 191);"/>
                        <engine:VisualElement class="generator-clip-row">
                            <AnysoundDropdown name="ExtraDropdown" color="#FF80BFFF" show-icons="false" class="generator-clip-row__type"/>
                            <AnysoundDropdown name="ExtraClipDropdown" color="#FF80BFFF" show-icons="false" class="generator-clip-row__clip"/>
                            <engine:Button name="ExtraRandomButton" tooltip="Randomize this row" class="generator-random-button" style="color: #FF80BF; border-left-color: #FF80BF; border-right-color: #FF80BF; border-top-color: #FF80BF; border-bottom-color: #FF80BF;">
                                <AnysoundDiceIcon class="generator-random-button__icon"/>
                            </engine:Button>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="SizeElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(60, 166, 255);">
                            <engine:Label text="SIZE" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(60, 166, 255);"/>
                        <engine:VisualElement class="generator-hint-row">
                            <engine:Label text="SMALL" class="generator-hint-label" style="color: rgb(60, 166, 255);"/>
                            <engine:Label text="BIG" class="generator-hint-label" style="color: rgb(60, 166, 255);"/>
                        </engine:VisualElement>
                        <AnysoundSlider label="Size" name="SizeSlider" show-input-field="false" high-value="1" low-value="0" color="#3CA6FFFF" unit="%" inverted="false" value="1" show-label="false" show-values="false" style="flex-shrink: 0; height: 60px; flex-grow: 0;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="AudioElement" class="generator-section">
                    <engine:VisualElement class="generator-section-header">
                        <engine:VisualElement class="generator-section-tag" style="background-color: rgb(244, 64, 78);">
                            <engine:Label text="AUDIO" class="section-label"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="generator-section-content">
                        <engine:VisualElement class="generator-section-line" style="background-color: rgb(244, 64, 78);"/>
                        <engine:VisualElement name="Playhead" style="flex-grow: 1; height: 10px; position: relative; width: 2px; display: flex; background-color: rgb(244, 64, 78); max-height: 14px; opacity: 1; left: 5%; visibility: hidden;"/>
                        <engine:VisualElement name="WaveformContainer" style="flex-grow: 1; height: 66px; background-color: rgba(255, 255, 255, 0);"/>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="Buttons" style="flex-grow: 0; flex-direction: row; height: 142px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 10px;">
            <engine:VisualElement class="anysound-button" style="flex-grow: 1;">
                <engine:Label text="Export to project" style="-unity-text-align: middle-left; height: 30px; width: 150px;"/>
                <engine:Button display-tooltip-when-elided="false" name="ExportButton" class="anysound-button-box" style="background-image: resource(&quot;button_export&quot;); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 100px; -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142); margin-right: 20px;"/>
            </engine:VisualElement>
            <engine:VisualElement class="anysound-button" style="flex-grow: 1;">
                <engine:Label text="Preview sound (spacebar)" style="-unity-text-align: middle-left; height: 30px; width: 150px;"/>
                <engine:Button display-tooltip-when-elided="false" name="PreviewButton" class="anysound-button-box" style="background-image: resource(&quot;button_preview&quot;); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 100px; -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142);"/>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button text="Create preset" name="RedrawButton" style="display: none;"/>
    </engine:ScrollView>
</engine:UXML>
