.ui-dropdown {
    margin: 8px 0 0 0;
    height: 26px;
    -unity-font-definition: url("project://database/Packages/com.floppyclub.anysound/Editor/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&guid=e1005e063d97148efacf3cc3692560e8&type=3#IBMPlexMono-Medium");
}

.ui-dropdown .unity-base-popup-field__input {
    background-color: rgb(0, 0, 0);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(94, 94, 94);
    color: rgb(255, 255, 255);
    font-size: 12px;
    padding-left: 6px;
}

.ui-dropdown .unity-base-popup-field__input:hover {
    border-color: rgb(255, 255, 255);
}

.ui-dropdown--action .unity-base-popup-field__input {
    color: rgb(255, 187, 34);
}

.ui-dropdown--extra .unity-base-popup-field__input {
    color: rgb(255, 128, 191);
}
