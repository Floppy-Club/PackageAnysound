<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Anysound/Shared/uss/AnysoundStyles.uss?fileID=7433441132597879392&amp;guid=1e040dc50fcfa49f0aa3378443d2ffaa&amp;type=3#AnysoundStyles" />
    <engine:VisualElement name="SoundPreviewContainer" style="flex-grow: 1; margin-bottom: 0; flex-direction: column; height: 120px; max-height: 120px; min-height: 120px; background-color: rgb(0, 0, 0); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-left: 0;">
        <engine:Label text="No sound loaded" name="SoundName" style="flex-grow: 1; height: 20px; max-height: 20px; flex-shrink: 1; color: rgb(161, 161, 161); font-size: 12px; -unity-text-align: upper-left; min-height: 20px; flex-direction: row; align-self: stretch; align-items: auto; justify-content: flex-start; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        <engine:VisualElement style="flex-grow: 1; flex-direction: row; height: 80px; min-height: 80px; max-height: 80px;">
            <engine:Button name="PlayButton" text="Play sound" class="anysound-button-box" style="height: 80px; width: 80px; background-image: none; flex-shrink: 0; flex-grow: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-size: 90% 90%; -unity-background-image-tint-color: rgb(255, 255, 255); color: rgb(255, 255, 255);" />
            <engine:VisualElement name="WaveformContainer" style="flex-grow: 1; width: 100%;" />
            <engine:VisualElement name="Playhead" style="flex-grow: 0; background-color: rgb(255, 0, 0); width: 2px; left: -281px; display: flex; visibility: hidden;" />
            <engine:VisualElement name="Waveform" style="flex-grow: 1; background-image: none; height: 80px; min-width: 100px; width: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 10px; display: none;" />
            <engine:Button name="LoadButton" text="Load sound" class="anysound-button-box" style="height: 80px; flex-grow: 1; width: 80px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: none; background-size: 90% 80%; -unity-background-image-tint-color: rgb(255, 255, 255); color: rgb(255, 255, 255);" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
