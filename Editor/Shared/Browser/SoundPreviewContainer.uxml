<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Anysound/Shared/uss/AnysoundStyles.uss?fileID=7433441132597879392&amp;guid=1e040dc50fcfa49f0aa3378443d2ffaa&amp;type=3#AnysoundStyles" />
    <engine:VisualElement name="SoundPreviewContainer" style="flex-grow: 1; margin-bottom: 0; flex-direction: column; height: 170px; max-height: 170px; min-height: 170px; background-color: rgb(0, 0, 0); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-left: 0;">
        <engine:Label text="No sound loaded" name="SoundName" style="flex-grow: 1; height: 20px; max-height: 20px; flex-shrink: 1; color: rgb(161, 161, 161); font-size: 12px; -unity-text-align: upper-left; min-height: 20px; flex-direction: row; align-self: stretch; align-items: auto; justify-content: flex-start; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        <engine:VisualElement style="flex-grow: 1; flex-direction: row; align-items: flex-end; height: 130px; min-height: 130px; max-height: 130px;">
            <engine:VisualElement class="anysound-button" style="flex-grow: 0; flex-shrink: 0;">
                <engine:Label text="Preview" style="-unity-text-align: middle-left; height: 30px;"/>
                <engine:Button name="PlayButton" display-tooltip-when-elided="false" tooltip="Play sound" class="anysound-button-box" style="height: 100px; width: 100px; flex-grow: 0; flex-shrink: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: resource(&quot;button_preview&quot;); -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142);" />
            </engine:VisualElement>
            <engine:VisualElement name="WaveformContainer" style="flex-grow: 1; width: 100%; height: 100px; margin-left: 10px;" />
            <engine:VisualElement name="Playhead" style="flex-grow: 0; background-color: rgb(255, 0, 0); width: 2px; height: 100px; left: -281px; display: flex; visibility: hidden;" />
            <engine:VisualElement name="Waveform" style="flex-grow: 1; background-image: none; height: 100px; min-width: 100px; width: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 10px; display: none;" />
            <engine:VisualElement class="anysound-button" style="flex-grow: 0; flex-shrink: 0; margin-left: 8px;">
                <engine:Label text="Load" style="-unity-text-align: middle-left; height: 30px;"/>
                <engine:Button name="LoadButton" display-tooltip-when-elided="false" tooltip="Load the sound in its editor" class="anysound-button-box" style="height: 100px; width: 100px; flex-grow: 0; flex-shrink: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: resource(&quot;button_load&quot;); -unity-background-scale-mode: scale-to-fit; background-size: 80px 80px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(142, 142, 142); border-right-color: rgb(142, 142, 142); border-top-color: rgb(142, 142, 142); border-bottom-color: rgb(142, 142, 142);" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
